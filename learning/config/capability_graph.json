        "int.robotics.mechanical_design.cad": {
            "id": "int.robotics.mechanical_design.cad",
            "name": "CAD",
            "slug": "cad",
            "description": "Design precise digital parts, assemblies, drawings and manufacturing-ready models.",
            "concepts": {
                "cad.sketching": {
                    "name": "Sketching",
                    "description": "Create controlled 2D profiles with dimensions and constraints.",
                    "prerequisites": []
                },
                "cad.design_intent": {
                    "name": "Design Intent",
                    "description": "Build models that update predictably when requirements change.",
                    "prerequisites": [
                        "cad.sketching"
                    ]
                },
                "cad.part_modelling": {
                    "name": "Part Modelling",
                    "description": "Create solid parts using extrude, revolve, sweep, loft and feature operations.",
                    "prerequisites": [
                        "cad.sketching"
                    ]
                },
                "cad.parametric_design": {
                    "name": "Parametric Design",
                    "description": "Drive geometry using parameters, relationships and feature history.",
                    "prerequisites": [
                        "cad.design_intent",
                        "cad.part_modelling"
                    ]
                },
                "cad.assemblies": {
                    "name": "Assemblies",
                    "description": "Combine components using joints, mates and degrees of freedom.",
                    "prerequisites": [
                        "cad.part_modelling"
                    ]
                },
                "cad.interference": {
                    "name": "Interference & Motion",
                    "description": "Inspect clearances, collisions and mechanical movement.",
                    "prerequisites": [
                        "cad.assemblies"
                    ]
                },
                "cad.technical_drawings": {
                    "name": "Technical Drawings",
                    "description": "Communicate designs with orthographic, section and detail views.",
                    "prerequisites": [
                        "cad.part_modelling"
                    ]
                },
                "cad.tolerancing": {
                    "name": "Dimensions & Tolerances",
                    "description": "Specify fit, allowable variation and manufacturing intent.",
                    "prerequisites": [
                        "cad.technical_drawings"
                    ]
                },
                "cad.surface_modelling": {
                    "name": "Surface Modelling",
                    "description": "Create and control complex curved forms.",
                    "prerequisites": [
                        "cad.part_modelling"
                    ]
                },
                "cad.rendering": {
                    "name": "Rendering & Materials",
                    "description": "Apply materials, lighting and presentation-quality visualisation.",
                    "prerequisites": [
                        "cad.part_modelling"
                    ]
                },
                "cad.animation": {
                    "name": "Animation & Exploded Views",
                    "description": "Present motion, assembly sequence and exploded arrangements.",
                    "prerequisites": [
                        "cad.assemblies"
                    ]
                },
                "cad.manufacturing": {
                    "name": "Manufacturing Preparation",
                    "description": "Prepare models for 3D printing, CAM and fabrication.",
                    "prerequisites": [
                        "cad.part_modelling",
                        "cad.tolerancing"
                    ]
                },
                "cad.data_exchange": {
                    "name": "CAD Data Exchange",
                    "description": "Use STEP, STL and native formats without losing design intent.",
                    "prerequisites": [
                        "cad.part_modelling"
                    ]
                },
                "cad.version_control": {
                    "name": "Design Data Management",
                    "description": "Organise revisions, components and released design files.",
                    "prerequisites": [
                        "cad.data_exchange"
                    ]
                }
            },
            "relationships": [
