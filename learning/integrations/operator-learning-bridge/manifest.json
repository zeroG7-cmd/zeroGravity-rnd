{
  "manifest_version": 3,
  "name": "Operator Learning Bridge",
  "version": "1.1.0",
  "description": "Sends verified Boot.dev lesson completions to Operator Zero.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://www.boot.dev/*", "http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://www.boot.dev/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
